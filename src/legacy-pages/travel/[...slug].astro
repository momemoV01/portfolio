---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Record from '../../layouts/Record.astro';
import { isRoutable } from '../../lib/contentFilters';

export async function getStaticPaths() {
	const entries = await getCollection('travel', ({ data }) => isRoutable(data));
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: entry,
	}));
}

type Props = CollectionEntry<'travel'>;

const entry = Astro.props;
const { Content } = await render(entry);

const period = entry.data.startedAt
	? `${entry.data.startedAt.toISOString().split('T')[0]}${entry.data.endedAt ? ` - ${entry.data.endedAt.toISOString().split('T')[0]}` : ''}`
	: undefined;
const extraMeta = [
	entry.data.location,
	period,
	entry.data.cost && `비용 ${entry.data.cost}`,
	...entry.data.companions.map((name) => `동행 ${name}`),
].filter(Boolean) as string[];
---

<Record
	title={entry.data.title}
	description={entry.data.description}
	pubDate={entry.data.pubDate}
	updatedDate={entry.data.updatedDate}
	tags={entry.data.tags}
	typeLabel="여행"
	backHref="/travel"
	backLabel="여행"
	heroImage={entry.data.coverImage}
	extraMeta={extraMeta}
	comments={entry.data.visibility === 'public'}
>
	<Content />
</Record>
