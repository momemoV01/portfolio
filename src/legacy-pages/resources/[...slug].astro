---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Record from '../../layouts/Record.astro';
import { isRoutable } from '../../lib/contentFilters';
import { labelFrom, resourceStatusLabel, resourceTypeLabel } from '../../lib/labels';

export async function getStaticPaths() {
	const entries = await getCollection('resources', ({ data }) => isRoutable(data));
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: entry,
	}));
}

type Props = CollectionEntry<'resources'>;

const entry = Astro.props;
const { Content } = await render(entry);

const extraMeta = [
	entry.data.price && `가격 ${entry.data.price}`,
	entry.data.license && `라이선스 ${entry.data.license}`,
	entry.data.rating !== undefined && `평점 ${entry.data.rating}/5`,
].filter(Boolean) as string[];
---

<Record
	title={entry.data.title}
	description={entry.data.description}
	pubDate={entry.data.pubDate}
	updatedDate={entry.data.updatedDate}
	tags={entry.data.tags}
	typeLabel={`${labelFrom(resourceTypeLabel, entry.data.resourceType)} · ${labelFrom(resourceStatusLabel, entry.data.status)}`}
	backHref="/resources"
	backLabel="도구함"
	heroImage={entry.data.coverImage}
	extraMeta={extraMeta}
	comments={entry.data.visibility === 'public'}
>
	<Content />
</Record>
