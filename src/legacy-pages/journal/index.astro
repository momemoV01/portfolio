---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import RecordCard from '../../components/RecordCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { SITE_TITLE } from '../../consts';
import { isPublic } from '../../lib/contentFilters';
import { journalCategoryLabel, labelFrom } from '../../lib/labels';

const entries = (await getCollection('journal', ({ data }) => isPublic(data))).sort(
	(a, b) => Number(b.data.pinned) - Number(a.data.pinned) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`기록 · ${SITE_TITLE}`} description="일상, 생각, 작업 루틴을 남기는 공개 기록" />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-5xl px-5 py-14 sm:px-6">
			<SectionHeader
				kicker="Journal"
				title="짧은 기록"
				description="프로젝트 문서로 만들기엔 작지만, 나중의 나에게 쓸모 있을 생각과 생활의 조각들."
				level="h1"
			/>
			<div class="grid gap-4 md:grid-cols-2">
				{entries.map((entry) => (
					<RecordCard
						href={`/journal/${entry.id}/`}
						title={entry.data.title}
						description={entry.data.description}
						pubDate={entry.data.pubDate}
						meta={labelFrom(journalCategoryLabel, entry.data.category)}
						tags={entry.data.tags}
						image={entry.data.heroImage}
						accent={entry.data.pinned}
					/>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>
