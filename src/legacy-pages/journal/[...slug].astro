---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Record from '../../layouts/Record.astro';
import { isRoutable } from '../../lib/contentFilters';
import { journalCategoryLabel, labelFrom } from '../../lib/labels';

export async function getStaticPaths() {
	const entries = await getCollection('journal', ({ data }) => isRoutable(data));
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: entry,
	}));
}

type Props = CollectionEntry<'journal'>;

const entry = Astro.props;
const { Content } = await render(entry);
---

<Record
	title={entry.data.title}
	description={entry.data.description}
	pubDate={entry.data.pubDate}
	updatedDate={entry.data.updatedDate}
	tags={entry.data.tags}
	typeLabel={labelFrom(journalCategoryLabel, entry.data.category)}
	backHref="/journal"
	backLabel="기록"
	heroImage={entry.data.heroImage}
	comments={entry.data.visibility === 'public'}
>
	<Content />
</Record>
