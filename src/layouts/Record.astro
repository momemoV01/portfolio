---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Comments from '../components/Comments.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import MermaidScript from '../components/MermaidScript.astro';
import MetaPill from '../components/MetaPill.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	tags?: string[];
	typeLabel: string;
	backHref: string;
	backLabel: string;
	heroImage?: ImageMetadata;
	isPrivate?: boolean;
	comments?: boolean;
	extraMeta?: string[];
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	tags = [],
	typeLabel,
	backHref,
	backLabel,
	heroImage,
	isPrivate = false,
	comments = true,
	extraMeta = [],
} = Astro.props;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={isPrivate ? `[PRIVATE] ${title}` : title} description={description || title} image={heroImage} />
		{isPrivate && <meta name="robots" content="noindex,nofollow" />}
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-3xl px-6 py-12">
			<a href={backHref} class="mb-8 inline-flex text-sm font-bold text-[var(--color-muted)] hover:text-[var(--color-accent)]">
				← {backLabel}
			</a>

			{isPrivate && (
				<div class="mb-6 rounded-lg border border-[var(--color-danger)]/40 bg-[var(--color-danger)]/10 px-4 py-3 text-xs font-bold text-[var(--color-danger)]">
					비공개 기록 · production 공개 대상 아님
				</div>
			)}

			<article>
				<header class="mb-8 border-b border-[var(--color-border)] pb-8">
					<div class="mb-4 flex flex-wrap items-center gap-2">
						<MetaPill label={typeLabel} tone="accent" />
						<time class="text-xs font-bold text-[var(--color-muted)]">
							<FormattedDate date={pubDate} />
						</time>
						{updatedDate && (
							<span class="text-xs font-bold text-[var(--color-muted)]">
								수정 <FormattedDate date={updatedDate} />
							</span>
						)}
					</div>
					<h1 class="mb-4 leading-tight">{title}</h1>
					{description && <p class="text-lg leading-relaxed text-[var(--color-fg-dim)]">{description}</p>}
					{(tags.length > 0 || extraMeta.length > 0) && (
						<div class="mt-5 flex flex-wrap gap-2">
							{extraMeta.map((meta) => <MetaPill label={meta} />)}
							{tags.map((tag) => <span class="text-xs font-semibold text-[var(--color-muted)]">#{tag}</span>)}
						</div>
					)}
				</header>

				{heroImage && (
					<Image
						width={1020}
						height={574}
						src={heroImage}
						alt={title}
						class="mb-10 aspect-video w-full rounded-lg border border-[var(--color-border)] object-cover"
					/>
				)}

				<div class="prose">
					<slot />
				</div>
			</article>

			{comments && !isPrivate && <Comments />}
		</main>
		<Footer />
		<MermaidScript />
	</body>
</html>
