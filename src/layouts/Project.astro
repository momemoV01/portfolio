---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Comments from '../components/Comments.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import MermaidScript from '../components/MermaidScript.astro';
import RecordCard from '../components/RecordCard.astro';
import { isPublic } from '../lib/contentFilters';
import {
	devlogTypeLabel,
	labelFrom,
	projectStatusLabel,
	resourceStatusLabel,
	resourceTypeLabel,
} from '../lib/labels';

type ProjectData = CollectionEntry<'projects'>['data'];

interface Props extends ProjectData {
	projectId: string;
	isPrivate?: boolean;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	coverImage,
	engine,
	platforms,
	tech,
	role,
	duration,
	status,
	playableUrl,
	repoUrl,
	videoUrl,
	projectId,
	isPrivate = false,
} = Astro.props;

const relatedResources = (await getCollection('resources', ({ data }) => isPublic(data)))
	.filter((resource) => resource.data.relatedProjects.includes(projectId))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const projectDevlogs = (await getCollection('devlogs', ({ data }) => isPublic(data)))
	.filter((devlog) => devlog.id.startsWith(`${projectId}/`))
	.sort((a, b) => a.data.seq - b.data.seq);
---

<html lang="ko">
	<head>
		<BaseHead title={isPrivate ? `[DRAFT] ${title}` : title} description={description} />
		{isPrivate && <meta name="robots" content="noindex,nofollow" />}
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-6xl px-6 py-12">
			{isPrivate && (
				<div class="mb-6 rounded-lg border border-[var(--color-danger)]/40 bg-[var(--color-danger)]/10 px-4 py-3 text-xs font-bold text-[var(--color-danger)]">
					비공개 프로젝트 · production 공개 대상 아님
				</div>
			)}

			<a href={isPrivate ? '/private' : '/projects'} class="mb-8 inline-flex text-sm font-bold text-[var(--color-muted)] hover:text-[var(--color-accent)]">
				← {isPrivate ? '비공개 기록' : '프로젝트'}
			</a>

			<section class="grid gap-8 lg:grid-cols-[minmax(0,0.88fr)_minmax(320px,1.12fr)] lg:items-end">
				<div>
					<div class="mb-4 flex flex-wrap items-center gap-2">
						<span class="atlas-label">{engine}</span>
						<span class="atlas-label">{labelFrom(projectStatusLabel, status)}</span>
						<time class="text-xs font-bold text-[var(--color-muted)]"><FormattedDate date={pubDate} /></time>
						{updatedDate && (
							<span class="text-xs font-bold text-[var(--color-muted)]">수정 <FormattedDate date={updatedDate} /></span>
						)}
					</div>
					<h1 class="mb-4">{title}</h1>
					<p class="text-lg leading-relaxed text-[var(--color-fg-dim)]">{description}</p>
					{(playableUrl || repoUrl || videoUrl) && (
						<div class="mt-7 flex flex-wrap gap-4 text-sm">
							{playableUrl && <a href={playableUrl} target="_blank" class="atlas-link">데모 열기 →</a>}
							{videoUrl && <a href={videoUrl} target="_blank" class="atlas-link">영상 보기 →</a>}
							{repoUrl && <a href={repoUrl} target="_blank" class="atlas-link">저장소 보기 →</a>}
						</div>
					)}
				</div>
				<div class="overflow-hidden rounded-lg border border-[var(--color-border)] bg-[rgba(255,250,240,0.7)]">
					<Image
						width={1200}
						height={675}
						src={coverImage}
						alt={title}
						class="aspect-[16/9] w-full object-cover"
					/>
				</div>
			</section>

			<section class="my-10 grid border-y border-[var(--color-border)] md:grid-cols-4">
				<div class="border-b border-[var(--color-border)] py-5 md:border-b-0 md:border-r md:pr-5">
					<div class="mb-1 text-xs font-bold text-[var(--color-muted)]">역할</div>
					<div class="text-sm font-semibold">{role}</div>
				</div>
				<div class="border-b border-[var(--color-border)] py-5 md:border-b-0 md:border-r md:px-5">
					<div class="mb-1 text-xs font-bold text-[var(--color-muted)]">기간</div>
					<div class="text-sm font-semibold">{duration || '기록 예정'}</div>
				</div>
				<div class="border-b border-[var(--color-border)] py-5 md:border-b-0 md:border-r md:px-5">
					<div class="mb-1 text-xs font-bold text-[var(--color-muted)]">엔진</div>
					<div class="text-sm font-semibold">{engine}</div>
				</div>
				<div class="py-5 md:pl-5">
					<div class="mb-1 text-xs font-bold text-[var(--color-muted)]">플랫폼</div>
					<div class="text-sm font-semibold">{platforms.length > 0 ? platforms.join(', ') : '기록 예정'}</div>
				</div>
			</section>

			<div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_320px]">
				<article class="min-w-0">
					{tech.length > 0 && (
						<div class="mb-8 flex flex-wrap gap-2">
							{tech.map((item) => (
								<span class="rounded-full border border-[var(--color-border)] bg-[rgba(255,250,240,0.7)] px-3 py-1 text-xs font-semibold text-[var(--color-muted)]">
									{item}
								</span>
							))}
						</div>
					)}

					<div class="prose">
						<slot />
					</div>

					{projectDevlogs.length > 0 && (
						<section class="mt-12 border-t border-[var(--color-border)] pt-8">
							<h2 class="mb-5 text-2xl">작업 기록</h2>
							<div class="grid gap-3">
								{projectDevlogs.map((devlog) => {
									const [, slug] = devlog.id.split('/');
									return (
										<a href={`/projects/${projectId}/${slug}/`} class="group block border-b border-[var(--color-border)] pb-4">
											<div class="mb-1 text-xs font-bold text-[var(--color-muted)]">
												{String(devlog.data.seq).padStart(3, '0')}번째 기록
												{devlog.data.type && ` · ${labelFrom(devlogTypeLabel, devlog.data.type)}`}
											</div>
											<h3 class="mb-1 text-lg group-hover:text-[var(--color-accent)]">{devlog.data.title}</h3>
											<p class="line-clamp-2 text-sm leading-relaxed text-[var(--color-fg-dim)]">{devlog.data.description}</p>
										</a>
									);
								})}
							</div>
						</section>
					)}

					{!isPrivate && <Comments />}
				</article>

				<aside class="min-w-0">
					{relatedResources.length > 0 && (
						<section>
							<div class="mb-5 border-b border-[var(--color-border)] pb-3">
								<h2 class="text-2xl">사용한 재료</h2>
								<p class="mt-2 text-sm leading-relaxed text-[var(--color-fg-dim)]">이 프로젝트와 연결된 플러그인, 에셋, 참고 자료입니다.</p>
							</div>
							<div class="grid gap-4">
								{relatedResources.map((resource) => (
									<RecordCard
										href={`/resources/${resource.id}/`}
										title={resource.data.title}
										description={resource.data.description}
										pubDate={resource.data.pubDate}
										meta={`${labelFrom(resourceTypeLabel, resource.data.resourceType)} · ${labelFrom(resourceStatusLabel, resource.data.status)}`}
										tags={resource.data.tags}
										image={resource.data.coverImage}
										accent={resource.data.status === 'using'}
									/>
								))}
							</div>
						</section>
					)}
				</aside>
			</div>
		</main>
		<Footer />
		<MermaidScript />
	</body>
</html>
