---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Comments from '../components/Comments.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import MermaidScript from '../components/MermaidScript.astro';
import MetaPill from '../components/MetaPill.astro';
import { devlogTypeLabel, labelFrom } from '../lib/labels';

type DevlogData = CollectionEntry<'devlogs'>['data'];
type ProjectEntry = CollectionEntry<'projects'>;

interface Props extends DevlogData {
	devlogId: string;
	projectEntry: ProjectEntry;
	prevDevlog?: { id: string; project: string; slug: string; seq: number; title: string } | null;
	nextDevlog?: { id: string; project: string; slug: string; seq: number; title: string } | null;
	isPrivate?: boolean;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	seq,
	type,
	commits,
	tags,
	projectEntry,
	prevDevlog,
	nextDevlog,
	isPrivate = false,
} = Astro.props;

const projectLink = isPrivate
	? `/private/projects/${projectEntry.id}/`
	: `/projects/${projectEntry.id}/`;

const devlogHref = (devlog: { project: string; slug: string }) =>
	isPrivate ? `/private/devlogs/${devlog.project}/${devlog.slug}/` : `/projects/${devlog.project}/${devlog.slug}/`;

const repoUrl = projectEntry.data.repoUrl;
const seqStr = String(seq).padStart(3, '0');
---

<html lang="ko">
	<head>
		<BaseHead title={isPrivate ? `[DRAFT] ${title}` : title} description={description} />
		{isPrivate && <meta name="robots" content="noindex,nofollow" />}
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-3xl px-6 py-12">
			{isPrivate && (
				<div class="mb-6 rounded-lg border border-[var(--color-danger)]/40 bg-[var(--color-danger)]/10 px-4 py-3 text-xs font-bold text-[var(--color-danger)]">
					비공개 작업 일지 · production 공개 대상 아님
				</div>
			)}

			<a href={projectLink} class="mb-8 inline-flex text-sm font-bold text-[var(--color-muted)] hover:text-[var(--color-accent)]">
				← {projectEntry.data.title}
			</a>

			<article>
				<header class="mb-8 border-b border-[var(--color-border)] pb-8">
					<div class="mb-4 flex flex-wrap items-center gap-2">
						<MetaPill label={`${seqStr}번째 기록`} tone="accent" />
						{type && <MetaPill label={labelFrom(devlogTypeLabel, type)} tone="slate" />}
						<time class="text-xs font-bold text-[var(--color-muted)]"><FormattedDate date={pubDate} /></time>
						{updatedDate && (
							<span class="text-xs font-bold text-[var(--color-muted)]">수정 <FormattedDate date={updatedDate} /></span>
						)}
					</div>
					<h1 class="mb-4 leading-tight">{title}</h1>
					<p class="text-lg leading-relaxed text-[var(--color-fg-dim)]">{description}</p>
					{tags && tags.length > 0 && (
						<div class="mt-5 flex flex-wrap gap-2">
							{tags.map((tag) => <span class="text-xs font-semibold text-[var(--color-muted)]">#{tag}</span>)}
						</div>
					)}
				</header>

				{heroImage && (
					<Image
						width={1020}
						height={574}
						src={heroImage}
						alt=""
						class="mb-10 aspect-video w-full rounded-lg border border-[var(--color-border)] object-cover"
					/>
				)}

				<div class="prose">
					<slot />
				</div>

				{commits && commits.length > 0 && (
					<section class="mt-12 border-t border-[var(--color-border)] pt-6">
						<h2 class="mb-4 text-2xl">관련 커밋</h2>
						<ul class="space-y-2 text-sm">
							{commits.map((sha) => (
								<li>
									{repoUrl ? (
										<a
											href={`${repoUrl}/commit/${sha}`}
											target="_blank"
											rel="noopener noreferrer"
											class="atlas-link"
										>
											{sha.slice(0, 7)} →
										</a>
									) : (
										<span class="font-semibold text-[var(--color-fg-dim)]">{sha.slice(0, 7)}</span>
									)}
								</li>
							))}
						</ul>
					</section>
				)}

				<nav class="mt-12 grid gap-4 border-t border-[var(--color-border)] pt-8 sm:grid-cols-2">
					<div>
						{prevDevlog && (
							<a href={devlogHref(prevDevlog)} class="record-card group">
								<div class="mb-2 text-xs font-bold text-[var(--color-muted)]">이전 기록</div>
								<div class="mb-1 text-sm font-bold text-[var(--color-accent)]">
									{String(prevDevlog.seq).padStart(3, '0')}
								</div>
								<div class="truncate text-sm font-semibold group-hover:text-[var(--color-accent)]">{prevDevlog.title}</div>
							</a>
						)}
					</div>
					<div>
						{nextDevlog && (
							<a href={devlogHref(nextDevlog)} class="record-card group text-right">
								<div class="mb-2 text-xs font-bold text-[var(--color-muted)]">다음 기록</div>
								<div class="mb-1 text-sm font-bold text-[var(--color-accent)]">
									{String(nextDevlog.seq).padStart(3, '0')}
								</div>
								<div class="truncate text-sm font-semibold group-hover:text-[var(--color-accent)]">{nextDevlog.title}</div>
							</a>
						)}
					</div>
				</nav>
			</article>

			{!isPrivate && <Comments />}
		</main>
		<Footer />
		<MermaidScript />
	</body>
</html>
