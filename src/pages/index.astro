---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { RoadmapDrawerHost } from '../components/roadmap/RoadmapExplorer';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import dashboard from '../generated/project-dashboard.json';

const snapshotLabel = new Intl.DateTimeFormat('ko-KR', {
	dateStyle: 'medium',
	timeStyle: 'short',
	timeZone: 'Asia/Seoul',
}).format(new Date(dashboard.snapshotAt));

const shortDate = (value: string) => {
	if (!value) return '미정';
	return new Intl.DateTimeFormat('ko-KR', { month: 'short', day: 'numeric', timeZone: 'UTC' }).format(new Date(`${value}T12:00:00Z`));
};

const statusLabel = (status: string) => ({
	'in-progress': 'IN PROGRESS',
	review: 'REVIEW',
	done: 'DONE',
	todo: 'TODO',
	blocked: 'BLOCKED',
	cancelled: 'CANCELLED',
}[status] || status.toUpperCase());

const selectedValidations = ['Automation', 'Editor', 'Steam Development', 'Docs', 'Shipping']
	.map((label) => dashboard.validations.find((item) => item.label === label))
	.filter((item) => item !== undefined);
const automationDetail = dashboard.validations.find((item) => item.label === 'Automation')?.detail || '';
const automationScore = automationDetail.match(/\d+\/\d+/g)?.at(-1) || '—';

const chartActions = dashboard.currentActions
	.filter((task) => task.status !== 'done')
	.sort((left, right) => left.due.localeCompare(right.due) || left.code.localeCompare(right.code))
	.slice(0, 6);

const phaseStart = new Date(`${dashboard.project.start}T12:00:00Z`).getTime();
const phaseEnd = new Date(`${dashboard.project.due}T12:00:00Z`).getTime();
const phaseSpan = Math.max(1, phaseEnd - phaseStart);
const taskPosition = (start: string, due: string) => {
	const taskStart = new Date(`${start}T12:00:00Z`).getTime();
	const taskEnd = new Date(`${due}T12:00:00Z`).getTime();
	const left = Math.max(0, Math.min(100, ((taskStart - phaseStart) / phaseSpan) * 100));
	const right = Math.max(left + 7, Math.min(100, ((taskEnd - phaseStart) / phaseSpan) * 100));
	return `--task-left:${left.toFixed(2)}%;--task-width:${Math.max(7, right - left).toFixed(2)}%`;
};

const activityCells = [
	...Array.from({ length: new Date(`${dashboard.git.activity[0]?.date || dashboard.snapshotAt.slice(0, 10)}T12:00:00Z`).getUTCDay() }, () => null),
	...dashboard.git.activity,
];
const activityLevel = (count: number) => {
	if (count === 0) return 0;
	if (count === 1) return 1;
	if (count <= 3) return 2;
	if (count <= 5) return 3;
	return 4;
};
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="dashboard-main">
			<section class="dash-intro" aria-labelledby="dashboard-title">
				<div>
					<p class="eyebrow">Development overview / read-only snapshot</p>
					<h1 id="dashboard-title">RP Project Dashboard</h1>
					<p>일정, 검증, 문서와 저장소 활동을 한 화면에서 확인합니다. 일정 편집과 상태 변경은 Obsidian Project Manager가 계속 소유합니다.</p>
				</div>
				<div class="dash-intro-actions">
					<form action="/search" method="get" class="dash-search" role="search">
						<label class="sr-only" for="dashboard-search">개발 문서 검색</label>
						<input id="dashboard-search" name="q" type="search" placeholder="API, 기능 흐름, 가이드 검색" autocomplete="off" />
						<button type="submit">Search</button>
					</form>
					<p>Snapshot · {snapshotLabel}</p>
				</div>
			</section>

			<section class="dash-summary-grid" aria-label="프로젝트 요약">
				<article class="dash-summary-card is-primary">
					<span>{dashboard.project.phaseStage} phase</span>
					<strong>{dashboard.project.currentPhaseCode}</strong>
					<p>{dashboard.project.currentPhaseTitle}</p>
				</article>
				<article class="dash-summary-card">
					<span>Roadmap progress</span>
					<strong>{dashboard.project.progress}%</strong>
					<div class="dash-meter" aria-label={`진행률 ${dashboard.project.progress}%`}><i style={`width:${dashboard.project.progress}%`}></i></div>
				</article>
				<article class="dash-summary-card">
					<span>In review</span>
					<strong>{dashboard.project.reviewCount}</strong>
					<p>Roadmap actions</p>
				</article>
				<article class:list={['dash-summary-card', dashboard.project.blockedCount > 0 && 'has-warning']}>
					<span>Blocked</span>
					<strong>{dashboard.project.blockedCount}</strong>
					<p>Work Report 기준</p>
				</article>
				<article class="dash-summary-card is-milestone">
					<span>Next milestone</span>
					<strong>{dashboard.project.nextMilestone?.code || '—'}</strong>
					<p>{dashboard.project.nextMilestone ? shortDate(dashboard.project.nextMilestone.due) : '미정'}</p>
				</article>
			</section>

			<section class="dash-panel dash-roadmap-panel" aria-labelledby="roadmap-title">
				<header class="dash-panel-heading">
					<div>
						<p class="eyebrow">Project Manager snapshot</p>
						<h2 id="roadmap-title">Compact Roadmap</h2>
					</div>
					<a class="dash-link" href="/roadmap">전체 Roadmap 보기 <span aria-hidden="true">→</span></a>
				</header>

				<div class="dash-phase-strip" aria-label="Phase 16부터 20까지 일정">
					{dashboard.phases.map((phase) => (
						<button type="button" data-roadmap-id={phase.id} class:list={['dash-phase-cell', phase.id === dashboard.project.currentPhaseId && 'is-current']}>
							<div><strong>{phase.code}</strong><span>{shortDate(phase.start)} – {shortDate(phase.due)}</span></div>
							<i><b style={`width:${phase.progress}%`}></b></i>
						</button>
					))}
				</div>

				<div class="dash-gantt">
					<div class="dash-gantt-axis" aria-hidden="true">
						<span>{shortDate(dashboard.project.start)}</span>
						<span>{dashboard.project.currentPhaseCode} · {dashboard.project.currentPhaseTitle}</span>
						<span>{shortDate(dashboard.project.due)}</span>
					</div>
					<div class="dash-gantt-rows">
						{chartActions.map((task) => (
							<div class="dash-gantt-row">
								<button type="button" data-roadmap-id={task.id} class:list={['dash-task-bar', `is-${task.status}`]} style={taskPosition(task.start, task.due)} title={`${task.code} · ${task.title} · ${task.progress}%`}>
									<span>{task.code}</span><strong>{task.title}</strong><em>{task.progress}%</em>
								</button>
							</div>
						))}
						<div class="dash-milestone-line" aria-hidden="true"><i></i></div>
					</div>
					<div class="dash-gantt-foot">
						<span>막대는 Project Manager의 잠정 일정을 반영합니다. 항목을 선택하면 상세 사이드 뷰가 열립니다.</span>
						<strong>{dashboard.project.nextMilestone?.code} · {shortDate(dashboard.project.nextMilestone?.due || '')}</strong>
					</div>
				</div>
				<RoadmapDrawerHost snapshot={dashboard} client:load />
			</section>

			<div class="dash-two-column">
				<section class="dash-panel" aria-labelledby="action-title">
					<header class="dash-panel-heading is-compact">
						<div><p class="eyebrow">Work Report</p><h2 id="action-title">Open Actions</h2></div>
						<span class="dash-count">{String(dashboard.openActions.length).padStart(2, '0')}</span>
					</header>
					<div class="dash-action-list">
						{dashboard.openActions.length === 0 && (
							<div class="dash-empty-state"><strong>Open Action 없음</strong><p>이전 Phase는 마감됐습니다. 다음 Phase는 Kickoff 승인 뒤 시작합니다.</p></div>
						)}
						{dashboard.openActions.map((action) => (
							<article class:list={['dash-action', action.blocked && 'is-blocked']}>
								<div class="dash-action-top">
									<code>{action.code}</code>
									<span>{action.assignee}</span>
								</div>
								<h3>{action.title}</h3>
								<p>{action.doneCondition}</p>
								{action.blocked && <small>BLOCKED · {action.blockingReason}</small>}
							</article>
						))}
					</div>
				</section>

				<section class="dash-panel" aria-labelledby="validation-title">
					<header class="dash-panel-heading is-compact">
						<div><p class="eyebrow">Latest evidence · {dashboard.project.evidencePhaseCode}</p><h2 id="validation-title">Validation Snapshot</h2></div>
						<span class="dash-count">{automationScore}</span>
					</header>
					<div class="dash-validation-list">
						{selectedValidations.map((item) => item && (
							<article>
								<span class:list={['dash-status', `is-${item.status.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`]}>{item.status}</span>
								<div><h3>{item.label}</h3><p>{item.detail}</p></div>
							</article>
						))}
					</div>
				</section>
			</div>

			<section class="dash-panel dash-repository-panel" aria-labelledby="repository-title">
				<header class="dash-panel-heading">
					<div>
						<p class="eyebrow">Committed history only</p>
						<h2 id="repository-title">Repository Activity</h2>
					</div>
					<div class="dash-repo-meta">
						<span><b>{dashboard.git.commitsLastYear}</b> commits / 12 months</span>
						<code>{dashboard.git.branch || 'local snapshot'}</code>
					</div>
				</header>

				<div class="dash-repository-grid">
					<div class="dash-heatmap-wrap">
						<div class="dash-months" aria-hidden="true"><span>Aug</span><span>Sep</span><span>Oct</span><span>Nov</span><span>Dec</span><span>Jan</span><span>Feb</span><span>Mar</span><span>Apr</span><span>May</span><span>Jun</span><span>Jul</span></div>
						<div class="dash-heatmap-layout">
							<div class="dash-weekdays" aria-hidden="true"><span>Mon</span><span>Wed</span><span>Fri</span></div>
							<div class="dash-heatmap" aria-label="최근 1년 RP 저장소 커밋 활동">
								{activityCells.map((day) => day ? (
									<i class={`level-${activityLevel(day.count)}`} title={`${day.date} · ${day.count} commits`} aria-label={`${day.date}, ${day.count} commits`}></i>
								) : <i class="is-empty" aria-hidden="true"></i>)}
							</div>
						</div>
						<div class="dash-heatmap-legend"><span>{dashboard.git.commitsThisMonth} commits this month</span><div><small>Less</small><i class="level-0"></i><i class="level-1"></i><i class="level-2"></i><i class="level-3"></i><i class="level-4"></i><small>More</small></div></div>
					</div>

					<div class="dash-commit-list">
						<h3>Recent commits</h3>
						{dashboard.git.recentCommits.map((commit) => commit.url ? (
							<a href={commit.url} target="_blank" rel="noreferrer">
								<code>{commit.shortHash}</code><span>{commit.subject}</span><time>{commit.date}</time>
							</a>
						) : (
							<div><code>{commit.shortHash}</code><span>{commit.subject}</span><time>{commit.date}</time></div>
						))}
					</div>
				</div>
			</section>

			<section class="dash-quick-links" aria-labelledby="quick-links-title">
				<div><p class="eyebrow">Documentation</p><h2 id="quick-links-title">Continue working</h2></div>
				<a href="/docs/reference/flows/Session_Room_Lifecycle"><span>01</span><strong>Feature Flows</strong><small>사용자 기능 흐름</small></a>
				<a href="/docs/reference/Online_Types_Reference"><span>02</span><strong>API Reference</strong><small>현재 코드 계약</small></a>
				<a href="/roadmap"><span>03</span><strong>Project Roadmap</strong><small>Phase와 작업 상세</small></a>
				<a href="/docs/guides/Debug_HUD_Guide"><span>04</span><strong>Guides</strong><small>Editor와 검증 절차</small></a>
				<a href="/archive"><span>05</span><strong>자료실</strong><small>과거 프로젝트와 작업 기록</small></a>
			</section>
		</main>
		<Footer />
	</body>
</html>
