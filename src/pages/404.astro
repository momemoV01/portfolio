---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_SHORT_TITLE } from '../consts';

Astro.response.status = 404;
---

<!doctype html>
<html lang="ko">
	<head><BaseHead title={`Not Found · ${SITE_SHORT_TITLE}`} description="요청한 문서를 찾을 수 없습니다." /></head>
	<body>
		<Header />
		<main class="error-main">
			<p class="eyebrow">404 / Document unavailable</p>
			<h1>요청한 문서를 찾을 수 없습니다.</h1>
			<p>동기화 대상에서 제외됐거나 경로가 변경된 문서일 수 있습니다.</p>
			<div><a href="/" class="primary-button">문서 홈</a><a href="/search" class="text-link">검색 열기 →</a></div>
		</main>
	</body>
</html>
