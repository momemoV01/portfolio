---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import FormattedDate from './FormattedDate.astro';
import MetaPill from './MetaPill.astro';

interface Props {
	href: string;
	title: string;
	description: string;
	pubDate: Date;
	meta?: string;
	tags?: string[];
	accent?: boolean;
	image?: ImageMetadata;
}

const { href, title, description, pubDate, meta, tags = [], accent = false, image } = Astro.props;
---

<a href={href} class:list={['record-card group overflow-hidden', image && 'p-0']}>
	{image && (
		<Image
			width={760}
			height={428}
			src={image}
			alt={title}
			class="aspect-[16/9] w-full border-b border-[var(--color-border)] object-cover"
		/>
	)}
	<div class:list={[image && 'p-5']}>
		<div class="mb-3 flex flex-wrap items-center gap-2">
			<time class="text-xs font-bold text-[var(--color-muted)]">
				<FormattedDate date={pubDate} />
			</time>
			{meta && <MetaPill label={meta} tone={accent ? 'accent' : 'default'} />}
		</div>
		<h3 class="mb-2 text-lg group-hover:text-[var(--color-accent)]">{title}</h3>
		<p class="line-clamp-2 text-sm leading-relaxed text-[var(--color-fg-dim)]">{description}</p>
		{tags.length > 0 && (
			<div class="mt-4 flex flex-wrap gap-1.5">
				{tags.slice(0, 3).map((tag) => (
					<span class="text-[11px] font-semibold text-[var(--color-muted)]">#{tag}</span>
				))}
			</div>
		)}
	</div>
</a>
