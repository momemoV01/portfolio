---
interface Props {
	label: string;
	tone?: 'default' | 'accent' | 'rust' | 'slate';
}

const { label, tone = 'default' } = Astro.props;

const toneClass = {
	default: 'border-[var(--color-border)] bg-[rgba(255,250,240,0.7)] text-[var(--color-muted)]',
	accent: 'border-[var(--color-accent)]/30 bg-[var(--color-accent-glow)] text-[var(--color-accent)]',
	rust: 'border-[var(--color-rust)]/30 bg-[rgba(168,95,59,0.1)] text-[var(--color-rust)]',
	slate: 'border-[var(--color-slate)]/30 bg-[rgba(70,93,111,0.1)] text-[var(--color-slate)]',
}[tone];
---

<span
	class:list={[
		'inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] font-bold leading-none',
		toneClass,
	]}
>
	{label}
</span>
